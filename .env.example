DATABASE_URL=postgres://cancham:CHANGE_MOI@localhost:5432/cancham

# Adresse publique du site (liens de désabonnement dans les courriels)
APP_URL=http://localhost:3000

# Envoi des courriels (factures, relances, rappels, newsletter). Sans SMTP_HOST, rien n'est envoyé.
# Exemple Brevo : SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 ; Gmail : smtp.gmail.com 465 + SMTP_SECURE=true + mot de passe d'application
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CanCham Madagascar <info@cancham.mg>"

# Facultatif : déclenchement externe des tâches automatiques (GET /api/cron avec « Authorization: Bearer <CRON_SECRET> »)
CRON_SECRET=
