# --- Stripe (paiements par carte) : https://dashboard.stripe.com/apikeys ---
# Clé secrète du compte de la plateforme (sk_test_… en essai, sk_live_… en production)
STRIPE_SECRET_KEY=
# Webhook du compte de la plateforme (abonnement des Chambres) : adresse <APP_URL>/api/paiements/stripe
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded, payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=
# Webhook des comptes connectés (cotisations des membres) : même adresse, « événements des comptes connectés »
# Événements : account.updated, checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_CONNECT_WEBHOOK_SECRET=
