{
  "name": "cancham-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "admin:creer": "tsx scripts/creer-admin.ts",
    "gm:creer": "tsx scripts/creer-gm.ts",
    "ressources:demo": "tsx --env-file=.env scripts/ressources-demo.ts",
    "messagerie:demo": "tsx --env-file=.env scripts/messagerie-demo.ts",
    "journal:demo": "tsx --env-file=.env scripts/journal-demo.ts",
    "actualites:demo": "tsx --env-file=.env scripts/actualites-demo.ts",
    "agenda:demo": "tsx --env-file=.env scripts/agenda-demo.ts",
    "maillage:demo": "tsx --env-file=.env scripts/maillage-demo.ts",
    "newsletter:demo": "tsx --env-file=.env scripts/newsletter-demo.ts",
    "motsdepasse:demo": "tsx --env-file=.env scripts/mot-de-passe-demo.ts",
    "tags:demo": "tsx --env-file=.env scripts/tags-demo.ts",
    "factures-plateforme:demo": "tsx --env-file=.env scripts/factures-plateforme-demo.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.4",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "stripe": "^23.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
