generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  candidature
  refusee
  en_attente
  a_jour
  en_retard
}

enum MemberType {
  morale
  physique
}

enum UserRole {
  visiteur
  membre
  admin
}

enum NiveauEquipe {
  administrateur
  manager
}

enum EventFormat {
  presentiel @map("Présentiel")
  webinaire  @map("Webinaire")
  hybride    @map("Hybride")
}

enum AttendeeStatus {
  a_valider @map("à valider")
  confirme  @map("confirmé")
  present   @map("présent")
  absent
}

enum NewsCategory {
  programmation     @map("Programmation")
  evenement_passe   @map("Événement passé")
  vie_de_la_chambre @map("Vie de la chambre")
  formation         @map("Formation")
}

enum MediaType {
  image
  video
}

enum MediaTheme {
  navy
  green
}

enum ResourceCategory {
  guide     @map("Guide")
  modele    @map("Modèle")
  formation @map("Formation")
  rapport   @map("Rapport")
}

enum ResourceFormat {
  pdf   @map("PDF")
  docx  @map("DOCX")
  video @map("Vidéo")
  image @map("Photo")
  page  @map("Page")
}

enum PricingType {
  gratuit
  payant
}

enum EmplacementOffre {
  partout
  actualites
  tableau_de_bord
}

enum InvoiceStatus {
  payee
  envoyee
}

enum ThreadType {
  individuel
  groupe
}

enum Devise {
  MGA
  CAD
}

enum PaiementStatut {
  en_cours
  annonce
  reussie
  echouee
  abandonnee
}

enum ModeReglement {
  mvola
  orange_money
  airtel_money
  virement
  depot
  especes
  carte
  plateforme
  paypal
}

enum StatutChambre {
  active
  suspendue
}

model Offre {
  id                  String   @id
  nom                 String
  forfait             Float    @default(0)
  parUtilisateur      Float    @default(0)
  utilisateursOfferts Int      @default(1)
  maxMembres          Int?
  maxUtilisateurs     Int?
  fonctions           String[] @default([])
  surMesure           Boolean  @default(false)
  prixFonctions       Json     @default("{}")
  ordre               Int      @default(0)
  updatedAt           DateTime @updatedAt

  chambres Chambre[]

  @@map("offres_plateforme")
}

enum EtapeDemarrage {
  offre
  paiement
  infos
}

enum ActionRetard {
  lecture
  blocage
}

model ReglagesPlateforme {
  id                    String       @id @default("plateforme")
  delaiRetard           Int          @default(15)
  relances              Int[]        @default([1, 7, 14])
  actionRetard          ActionRetard @default(lecture)
  commissionCotisations Float        @default(0)
  nom                   String       @default("")
  raisonSociale         String       @default("")
  adresse               String       @default("")
  courriel              String       @default("")
  telephone             String       @default("")
  neq                   String       @default("")
  numeroTps             String       @default("")
  numeroTvq             String       @default("")
  hebergeur             String       @default("")
  updatedAt             DateTime     @updatedAt

  @@map("reglages_plateforme")
}

model CompteGM {
  id                    String    @id @default(cuid())
  nom                   String
  email                 String    @unique
  motDePasse            String
  motDePasseModifieLe   DateTime?
  jetonReinitialisation String?   @unique
  jetonExpire           DateTime?
  createdAt             DateTime  @default(now())

  @@map("comptes_gm")
}

model Chambre {
  id        String   @id @default(cuid())
  slug      String   @unique
  domaine   String?  @unique
  nom       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offreId           String          @default("gratuite")
  offre             Offre           @relation(fields: [offreId], references: [id])
  fonctionsChoisies String[]        @default([])
  demarrage         EtapeDemarrage?
  paiementDiffere   Boolean         @default(false)
  statut            StatutChambre   @default(active)
  suspendueLe       DateTime?

  stripeClientId String? @unique
  stripeCarteId  String?
  carteMarque    String?
  carteFin       String?
  carteExpire    String?

  stripeCompteId    String? @unique
  stripeCompteActif Boolean @default(false)
  stripeComptePays  String?

  accesDevJusqua DateTime?
  accesDevPar    String?

  membres             Member[]
  utilisateurs        User[]
  evenements          Event[]
  actualites          News[]
  ressources          Resource[]
  dossiers            DossierRessource[]
  offres              Offer[]
  services            CanchamService[]
  factures            Invoice[]
  paiements           Paiement[]
  coordonneesPaiement CoordonneesPaiement?
  fils                MessageThread[]
  journal             AuditLog[]
  abonnes             Abonne[]
  typesRendezvous     TypeRendezvous[]
  rendezvous          Rendezvous[]
  misesEnRelation     MiseEnRelation[]
  lettres             Lettre[]
  tags                Tag[]
  facturesPlateforme  FacturePlateforme[]
  reglesTags          RegleTag[]
  profil              ProfilChambre?
  formulesAdhesion    FormuleAdhesion[]
  filsSupportIT       FilSupportIT[]

  @@map("chambres")
}

model FilSupportIT {
  id          String    @id @default(cuid())
  chambreId   String
  chambre     Chambre   @relation(fields: [chambreId], references: [id])
  membreId    String    @default("")
  luChambreLe DateTime?
  luGMLe      DateTime?
  dernierLe   DateTime  @default(now())
  createdAt   DateTime  @default(now())

  messages MessageSupportIT[]

  @@unique([chambreId, membreId])
  @@map("fils_support_it")
}

model MessageSupportIT {
  id       String       @id @default(cuid())
  filId    String
  fil      FilSupportIT @relation(fields: [filId], references: [id], onDelete: Cascade)
  deGM     Boolean      @default(false)
  auteur   String
  userId   String?
  texte    String
  envoyeLe DateTime     @default(now())

  pieces PieceSupportIT[]

  @@index([filId, envoyeLe])
  @@map("messages_support_it")
}

model PieceSupportIT {
  id        String           @id @default(cuid())
  nom       String
  type      TypePieceJointe
  fichier   String
  taille    Int
  messageId String
  message   MessageSupportIT @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([messageId])
  @@map("pieces_support_it")
}

model FormuleAdhesion {
  id        String  @id @default(cuid())
  chambreId String  @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])
  pays      String
  profil    String
  montant   Int
  devise    Devise  @default(CAD)
  ordre     Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membres Member[]

  @@index([chambreId])
  @@map("formules_adhesion")
}

model Member {
  id String @id @default(cuid())

  chambreId    String           @default("principale")
  chambre      Chambre          @relation(fields: [chambreId], references: [id])
  type         MemberType       @default(morale)
  nom          String
  secteur      String
  ville        String
  statut       MemberStatus     @default(candidature)
  formuleId    String?
  formule      FormuleAdhesion? @relation(fields: [formuleId], references: [id], onDelete: SetNull)
  adhesion     DateTime         @db.Date
  retardDepuis DateTime?        @db.Date

  activite String
  desc     String
  besoins  String?
  interets String?

  statutJuridique String?
  pays            String?
  siteweb         String?
  motivation      String?

  paiementNote String?

  accueilEnCours Boolean @default(false)

  cover  String?
  coverX Int     @default(50)
  coverY Int     @default(50)
  photo  String?
  logo   String?
  video  String?

  offresTags   String[] @default([]) @map("offres_tags")
  besoinsTags  String[] @default([]) @map("besoins_tags")
  interetsTags String[] @default([]) @map("interets_tags")
  etiquettes   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maillage      Maillage?
  relationsA    MiseEnRelation[] @relation("relationA")
  relationsB    MiseEnRelation[] @relation("relationB")
  users         User[]
  produits      Produit[]
  offres        Offer[]
  actualites    News[]
  factures      Invoice[]
  inscriptions  Registration[]
  rendezvous    Rendezvous[]
  notes         NoteMembre[]
  acces         AccesRessource[]
  accesDossiers AccesDossier[]
  reglements    Paiement[]

  @@index([statut])
  @@index([chambreId])
  @@map("members")
}

model User {
  id String @id @default(cuid())

  chambreId    String        @default("principale")
  chambre      Chambre       @relation(fields: [chambreId], references: [id])
  role         UserRole      @default(membre)
  niveauEquipe NiveauEquipe?
  nom          String
  fonction     String
  email        String
  tel          String?
  photo        String?

  motDePasse String?

  motDePasseModifieLe DateTime?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  contactPrincipal Boolean @default(false)

  jaimes             NewsLike[]
  participations     ParticipantFil[]
  commentaires       Comment[]
  jaimesCommentaires CommentLike[]
  rappels            Rappel[]
  jetons             JetonCompte[]
  notesMembres       NoteMembre[]
  abonnementsPush    AbonnementPush[]

  specialite String?
  lienVisio  String?
  recoitRdv  Boolean @default(false)

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  rendezvous Rendezvous[]       @relation("rdvPris")
  rdvRecus   Rendezvous[]       @relation("rdvHote")
  typesRdv   TypeRendezvous[]
  lectures   LectureRessource[]

  personne String?

  @@unique([chambreId, email])
  @@index([email])
  @@index([personne])
  @@index([memberId])
  @@index([chambreId])
  @@map("users")
}

model AbonnementPush {
  id       String  @id @default(cuid())
  endpoint String  @unique
  p256dh   String
  auth     String
  appareil String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  vuLe      DateTime @default(now())

  @@index([userId])
  @@map("abonnements_push")
}

enum ProduitType {
  produit
  service
}

model Produit {
  id          String      @id @default(cuid())
  label       String
  type        ProduitType @default(service)
  description String?
  prix        String?
  photos      String[]    @default([])
  ordre       Int         @default(0)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("produits")
}

model Event {
  id String @id @default(cuid())

  chambreId  String      @default("principale")
  chambre    Chambre     @relation(fields: [chambreId], references: [id])
  titre      String
  date       DateTime    @db.Date
  lieu       String
  format     EventFormat
  cap        Int
  payant     Boolean     @default(false)
  prix       Int         @default(0)
  public     Boolean     @default(true)
  prixPublic Int         @default(0)
  desc       String
  photo      String?
  debut      String?
  fin        String?
  pourQui    String?

  rappelJ7      Boolean @default(true)
  rappelJ1      Boolean @default(true)
  rappelH2      Boolean @default(false)
  rappelSujet   String?
  rappelMessage String?

  etiquettes String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inscriptions      Registration[]
  rappels           RappelEnvoye[]
  rappelsProgrammes RappelEvenement[]
  participants      Attendee[]
  programme         EventAgenda[]
  intervenants      EventIntervenant[]
  factures          Invoice[]

  @@index([date])
  @@index([chambreId])
  @@map("events")
}

model Registration {
  id   String @id @default(cuid())
  code String @unique

  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, memberId])
  @@map("registrations")
}

model EventAgenda {
  id     String  @id @default(cuid())
  heure  String
  titre  String
  detail String?
  ordre  Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ordre])
  @@map("event_agenda")
}

model RappelEnvoye {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type     String
  email    String
  envoyeLe DateTime @default(now())

  @@unique([eventId, type, email])
  @@map("rappels_envoyes")
}

model EventIntervenant {
  id         String  @id @default(cuid())
  nom        String
  fonction   String?
  entreprise String?
  bio        String?
  photo      String?
  ordre      Int

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, ordre])
  @@map("event_intervenants")
}

model Attendee {
  id         String         @id @default(cuid())
  nom        String
  entreprise String
  email      String
  telephone  String?
  statut     AttendeeStatus @default(confirme)
  code       String?        @unique
  presentLe  DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("attendees")
}

model Rappel {
  id    String   @id @default(cuid())
  titre String
  note  String?
  jour  DateTime @db.Date
  heure String?
  fait  Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, jour])
  @@map("rappels")
}

model News {
  id String @id @default(cuid())

  chambreId String       @default("principale")
  chambre   Chambre      @relation(fields: [chambreId], references: [id])
  titre     String
  date      DateTime     @db.Date
  cat       NewsCategory
  extrait   String
  corps     String
  public    Boolean      @default(false)

  mediaType     MediaType
  mediaTheme    MediaTheme
  images        String[]   @default([])
  mediaDuration String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberId  String?
  member    Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  auteurNom String?
  libre     Boolean @default(false)

  commentaires Comment[]
  jaimes       NewsLike[]

  @@index([date])
  @@index([memberId])
  @@index([chambreId])
  @@map("news")
}

model NewsLike {
  id String @id @default(cuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
  @@map("news_likes")
}

model Resource {
  id String @id @default(cuid())

  chambreId String           @default("principale")
  chambre   Chambre          @relation(fields: [chambreId], references: [id])
  titre     String
  cat       ResourceCategory
  fmt       ResourceFormat
  taille    String
  date      DateTime         @db.Date

  fichier     String?
  pages       Int?
  cover       String?
  description String?
  contenu     Json?

  type PricingType @default(gratuit)
  prix Int         @default(0)

  ordre Int @default(0)

  dossierId String?
  dossier   DossierRessource? @relation(fields: [dossierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commentaires Comment[]
  lectures     LectureRessource[]
  acces        AccesRessource[]

  @@index([type])
  @@index([dossierId])
  @@index([chambreId])
  @@map("resources")
}

model AccesRessource {
  id String @id @default(cuid())

  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  ouvertPar String

  createdAt DateTime @default(now())

  @@unique([resourceId, memberId])
  @@index([memberId])
  @@map("acces_ressources")
}

model LectureRessource {
  id String @id @default(cuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([resourceId])
  @@map("lectures_ressources")
}

model DossierRessource {
  id String @id @default(cuid())

  chambreId   String  @default("principale")
  chambre     Chambre @relation(fields: [chambreId], references: [id])
  nom         String
  cover       String?
  auteurNom   String?
  auteurRole  String?
  auteurBio   String?
  auteurPhoto String?
  restreint   Boolean @default(false)

  parentId String?
  parent   DossierRessource?  @relation("Arborescence", fields: [parentId], references: [id], onDelete: Cascade)
  enfants  DossierRessource[] @relation("Arborescence")

  ressources Resource[]
  acces      AccesDossier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([chambreId])
  @@map("dossiers_ressources")
}

model AccesDossier {
  id String @id @default(cuid())

  dossierId String
  dossier   DossierRessource @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  ouvertPar String

  createdAt DateTime @default(now())

  @@unique([dossierId, memberId])
  @@index([memberId])
  @@map("acces_dossiers")
}

model Comment {
  id         String   @id @default(cuid())
  auteur     String
  entreprise String
  texte      String
  date       DateTime @db.Date

  newsId     String?
  news       News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  modifieLe DateTime?

  jaimes CommentLike[]

  createdAt DateTime @default(now())

  @@index([newsId])
  @@index([resourceId])
  @@map("comments")
}

model CommentLike {
  id String @id @default(cuid())

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_likes")
}

model NoteMembre {
  id    String @id @default(cuid())
  texte String

  auteur String

  memberId String
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([memberId])
  @@map("notes_membres")
}

model Offer {
  id String @id @default(cuid())

  chambreId   String           @default("principale")
  chambre     Chambre          @relation(fields: [chambreId], references: [id])
  titre       String
  desc        String
  image       String?
  lien        String?
  prix        String?
  emplacement EmplacementOffre @default(partout)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([chambreId])
  @@map("offers")
}

model CanchamService {
  id String @id @default(cuid())

  chambreId String      @default("principale")
  chambre   Chambre     @relation(fields: [chambreId], references: [id])
  titre     String
  desc      String
  type      PricingType @default(gratuit)
  prix      Int         @default(0)
  icon      String      @default("award")
  image     String?
  lien      String?
  ordre     Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chambreId])
  @@map("cancham_services")
}

model Invoice {
  id String @id @default(cuid())

  chambreId String        @default("principale")
  chambre   Chambre       @relation(fields: [chambreId], references: [id])
  numero    String
  date      DateTime      @db.Date
  objet     String
  montant   Int
  devise    Devise        @default(CAD)
  statut    InvoiceStatus @default(envoyee)
  payeeLe   DateTime?     @db.Date
  relances  Int[]         @default([])

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  destinataireNom String?
  destinataire    Json?

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  paiements Paiement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chambreId, numero])
  @@index([memberId])
  @@index([eventId])
  @@index([chambreId])
  @@map("invoices")
}

model Paiement {
  id String @id @default(cuid())

  chambreId String  @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])

  reference String         @unique
  statut    PaiementStatut @default(en_cours)

  montant Int
  devise  Devise @default(CAD)

  mode ModeReglement

  transaction  String?
  notification Json?
  regleLe      DateTime?

  refBancaire String?
  detail      Json?
  annonceLe   DateTime?
  confirmePar String?

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([memberId])
  @@index([statut])
  @@index([chambreId])
  @@map("paiements")
}

model CoordonneesPaiement {
  id String @id @default(cuid())

  chambreId String  @unique @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])

  titulaire String @default("")
  banque    String @default("")
  agence    String @default("")
  rib       String @default("")
  iban      String @default("")
  bic       String @default("")

  mvola       String @default("")
  orangeMoney String @default("")
  airtelMoney String @default("")

  adresseBureau String @default("")
  horaires      String @default("")

  plateformes String @default("")
  paypal      String @default("")

  updatedAt DateTime @updatedAt

  @@map("coordonnees_paiement")
}

model MessageThread {
  id String @id @default(cuid())

  chambreId String     @default("principale")
  chambre   Chambre    @relation(fields: [chambreId], references: [id])
  type      ThreadType
  nom       String?
  avatar    String?
  equipe    Boolean    @default(false)

  visiteur    Json?
  visiteurCle String?

  createdAt DateTime @default(now())

  messages     Message[]
  participants ParticipantFil[]

  @@unique([chambreId, visiteurCle])
  @@index([chambreId])
  @@map("message_threads")
}

model ParticipantFil {
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  luLe     DateTime?
  ajouteLe DateTime  @default(now())

  @@id([threadId, userId])
  @@index([userId])
  @@map("participants_fils")
}

model Message {
  id     String   @id @default(cuid())
  auteur String
  texte  String
  sentAt DateTime

  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId String?

  modifieLe  DateTime?
  supprimeLe DateTime?
  transfere  Boolean   @default(false)

  piecesJointes PieceJointe[]

  @@index([threadId])
  @@map("messages")
}

enum TypePieceJointe {
  image
  video
  pdf
}

model PieceJointe {
  id      String          @id @default(cuid())
  nom     String
  type    TypePieceJointe
  fichier String
  taille  Int

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("pieces_jointes")
}

model AuditLog {
  id String @id @default(cuid())

  chambreId String   @default("principale")
  chambre   Chambre  @relation(fields: [chambreId], references: [id])
  action    String
  entite    String
  entiteId  String
  acteur    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@index([chambreId])
  @@map("audit_logs")
}

model JetonCompte {
  id        String    @id @default(cuid())
  empreinte String    @unique
  usage     String
  expire    DateTime
  utiliseLe DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("jetons_compte")
}

model Abonne {
  id String @id @default(cuid())

  chambreId String  @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])
  prenom    String
  email     String
  source    String  @default("vitrine")

  desabonneLe DateTime?

  synchroniseLe DateTime?

  erreurLe DateTime?
  inviteLe DateTime?

  etiquettes String[] @default([])

  createdAt DateTime @default(now())

  @@unique([chambreId, email])
  @@index([chambreId])
  @@map("abonnes")
}

model TypeRendezvous {
  id String @id @default(cuid())

  chambreId String  @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])
  titre     String
  detail    String?
  duree     Int     @default(30)
  actif     Boolean @default(true)
  ordre     Int     @default(0)

  hoteId     String?
  hote       User?   @relation(fields: [hoteId], references: [id], onDelete: SetNull)
  lieu       String  @default("bureau")
  couleur    String?
  prix       String?
  aConfirmer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rendezvous Rendezvous[]
  plages     Disponibilite[]

  @@index([chambreId])
  @@map("types_rendezvous")
}

model Disponibilite {
  id    String @id @default(cuid())
  jour  Int
  debut String
  fin   String

  typeId String
  type   TypeRendezvous @relation(fields: [typeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([typeId, jour])
  @@map("disponibilites")
}

model Rendezvous {
  id String @id @default(cuid())

  chambreId String  @default("principale")
  chambre   Chambre @relation(fields: [chambreId], references: [id])

  typeId String
  type   TypeRendezvous @relation(fields: [typeId], references: [id])

  userId   String
  user     User    @relation("rdvPris", fields: [userId], references: [id], onDelete: Cascade)
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  jour  DateTime @db.Date
  debut String
  fin   String

  motif String?

  hoteId     String?
  hote       User?     @relation("rdvHote", fields: [hoteId], references: [id], onDelete: SetNull)
  lieu       String    @default("bureau")
  lienVisio  String?
  statut     String    @default("confirme")
  confirmeLe DateTime?

  annuleLe  DateTime?
  annulePar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jour])
  @@index([userId])
  @@index([chambreId])
  @@map("rendezvous")
}

model Maillage {
  memberId   String    @id
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reponses   Json      @default("{}")
  rempliPar  String?
  commenceLe DateTime?
  completeLe DateTime?
  relanceLe  DateTime?
  majLe      DateTime  @default(now()) @updatedAt

  @@map("maillage")
}

model MiseEnRelation {
  id String @id @default(cuid())

  chambreId String   @default("principale")
  chambre   Chambre  @relation(fields: [chambreId], references: [id])
  memberAId String
  memberA   Member   @relation("relationA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberBId String
  memberB   Member   @relation("relationB", fields: [memberBId], references: [id], onDelete: Cascade)
  statut    String   @default("relation")
  note      String?
  createdAt DateTime @default(now())

  @@unique([memberAId, memberBId])
  @@index([chambreId])
  @@map("mises_en_relation")
}

model Lettre {
  id String @id @default(cuid())

  chambreId     String        @default("principale")
  chambre       Chambre       @relation(fields: [chambreId], references: [id])
  sujet         String
  contenu       String
  audience      Json          @default("{}")
  statut        String        @default("brouillon")
  destinataires Int           @default(0)
  envoyes       Int           @default(0)
  envoyeeLe     DateTime?
  programmeeLe  DateTime?
  auteur        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  envois        EnvoiLettre[]

  @@index([chambreId])
  @@map("lettres")
}

model EnvoiLettre {
  id        String    @id @default(cuid())
  lettreId  String
  lettre    Lettre    @relation(fields: [lettreId], references: [id], onDelete: Cascade)
  email     String
  resendId  String?   @unique
  livreLe   DateTime?
  ouvertLe  DateTime?
  clicLe    DateTime?
  erreurLe  DateTime?
  createdAt DateTime  @default(now())

  @@index([lettreId])
  @@index([email])
  @@map("envois_lettres")
}

model Tag {
  id String @id @default(cuid())

  chambreId String   @default("principale")
  chambre   Chambre  @relation(fields: [chambreId], references: [id])
  nom       String
  createdAt DateTime @default(now())

  @@unique([chambreId, nom])
  @@index([chambreId])
  @@map("tags")
}

model RappelEvenement {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  titre     String?
  dates     DateTime[] @default([])
  avant     Int        @default(0)
  sujet     String?
  message   String?
  createdAt DateTime   @default(now())

  @@index([eventId])
  @@map("rappels_evenement")
}

model FacturePlateforme {
  id String @id @default(cuid())

  chambreId        String    @default("principale")
  chambre          Chambre   @relation(fields: [chambreId], references: [id])
  numero           String
  date             DateTime  @db.Date
  forfait          Float
  utilisateurs     Int
  parUtilisateur   Float
  tauxTps          Float
  tauxTvq          Float
  sousTotal        Float
  tps              Float
  tvq              Float
  total            Float
  payeeLe          DateTime?
  stripePaiementId String?
  tentatives       Int       @default(0)
  dernierEchec     String?
  dernierEchecLe   DateTime?
  relances         Int[]     @default([])
  suivie           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@unique([chambreId, numero])
  @@index([chambreId])
  @@map("factures_plateforme")
}

model RegleTag {
  id String @id @default(cuid())

  chambreId String       @default("principale")
  chambre   Chambre      @relation(fields: [chambreId], references: [id])
  statut    MemberStatus
  tag       String
  actif     Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([chambreId, statut, tag])
  @@index([chambreId])
  @@map("regles_tags")
}

model ProfilChambre {
  id String @id @default(cuid())

  chambreId             String  @unique @default("principale")
  chambre               Chambre @relation(fields: [chambreId], references: [id])
  nom                   String  @default("")
  description           String  @default("")
  adresse               String  @default("")
  adresseRue            String  @default("")
  codePostal            String  @default("")
  ville                 String  @default("")
  province              String  @default("")
  pays                  String  @default("")
  telephone             String  @default("")
  email                 String  @default("")
  site                  String  @default("")
  logo                  String?
  couverture            String?
  logoFond              String?
  couleurPrincipale     String?
  couleurLaterale       String?
  couleurLaterale2      String?
  couleurHaut           String?
  couleurConnexion      String?
  couleurFondConnexion  String?
  couleurTexteConnexion String?
  relancesMembres       Int[]   @default([])

  raisonSociale      String  @default("")
  adresseFacturation String  @default("")
  neq                String  @default("")
  tps                String  @default("")
  tvq                String  @default("")
  nif                String  @default("")
  stat               String  @default("")
  logoFacture        String?
  mentionFacture     String  @default("")

  expediteurNom     String @default("")
  expediteurDomaine String @default("")
  expediteurEmail   String @default("")

  courrielEquipe  String @default("")
  facebook        String @default("")
  linkedin        String @default("")
  instagram       String @default("")
  youtube         String @default("")
  tiktok          String @default("")
  confidentialite String @default("")
  cgv             String @default("")
  copyright       String @default("")

  updatedAt DateTime @updatedAt

  @@map("profil_chambre")
}
